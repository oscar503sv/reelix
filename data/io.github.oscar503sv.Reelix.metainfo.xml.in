<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.oscar503sv.Reelix</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name translate="no">Reelix</name>
  <summary>Record your screen, natively on GNOME</summary>
  <developer id="io.github.oscar503sv">
    <name translate="no">Oscar Aragon</name>
  </developer>
  <description>
    <p>
      Reelix is a lightweight, local-first screen recorder built for GNOME and
      Wayland. It uses the XDG Desktop Portal and PipeWire to capture your
      screen or a single window, together with your microphone and system
      audio, and GStreamer to encode MP4 files, with hardware acceleration
      when available.
    </p>
    <p>Your recordings never leave your computer. There is no account, no cloud and no telemetry.</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <caption>Record your screen with microphone, system audio and camera</caption>
      <image>https://raw.githubusercontent.com/oscar503sv/reelix/v0.8.0/data/screenshots/main.png</image>
      <image xml:lang="es">https://raw.githubusercontent.com/oscar503sv/reelix/v0.8.0/data/screenshots/es/main.png</image>
    </screenshot>
    <screenshot>
      <caption>Your recordings, stored on your computer</caption>
      <image>https://raw.githubusercontent.com/oscar503sv/reelix/v0.8.0/data/screenshots/library.png</image>
      <image xml:lang="es">https://raw.githubusercontent.com/oscar503sv/reelix/v0.8.0/data/screenshots/es/library.png</image>
    </screenshot>
    <screenshot>
      <caption>Frame rate, quality, resolution and encoder</caption>
      <image>https://raw.githubusercontent.com/oscar503sv/reelix/v0.8.0/data/screenshots/preferences.png</image>
      <image xml:lang="es">https://raw.githubusercontent.com/oscar503sv/reelix/v0.8.0/data/screenshots/es/preferences.png</image>
    </screenshot>
    <screenshot>
      <caption>Dark style</caption>
      <image>https://raw.githubusercontent.com/oscar503sv/reelix/v0.8.0/data/screenshots/main-dark.png</image>
      <image xml:lang="es">https://raw.githubusercontent.com/oscar503sv/reelix/v0.8.0/data/screenshots/es/main-dark.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#c9c0ff</color>
    <color type="primary" scheme_preference="dark">#30364c</color>
  </branding>
  <launchable type="desktop-id">io.github.oscar503sv.Reelix.desktop</launchable>
  <url type="homepage">https://github.com/oscar503sv/reelix</url>
  <url type="bugtracker">https://github.com/oscar503sv/reelix/issues</url>
  <url type="vcs-browser">https://github.com/oscar503sv/reelix</url>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <releases>
    <release version="0.8.0" date="2026-11-01">
      <description>
        <p>The interface is now in English and Spanish, and open to translations into any language.</p>
      </description>
    </release>
    <release version="0.7.1" date="2026-11-01">
      <description>
        <p>The main window shows the new app icon, and the app moves to the GNOME 51 platform.</p>
      </description>
    </release>
    <release version="0.7.0" date="2026-11-01">
      <description>
        <p>Low resource usage: the camera bubble is processed on the GPU (about a third of the CPU it used), and a maximum recording resolution setting.</p>
        <p>New icon, RPM and Flatpak packages, and a more robust pause that works with every capture source.</p>
      </description>
    </release>
    <release version="0.6.0" date="2026-10-23">
      <description>
        <p>Much smaller files (no container padding), GPU encoding and colour conversion on Intel, and recording statistics.</p>
      </description>
    </release>
    <release version="0.5.0" date="2026-10-23">
      <description>
        <p>Pause and resume without gaps, countdown before recording, a recordings library (rename, show in folder, copy, details, move to trash), preferences and optional system-wide shortcuts.</p>
      </description>
    </release>
    <release version="0.4.0" date="2026-10-23">
      <description>
        <p>Floating camera bubble with a live preview and a colour-shifting border, recorded as part of the screen; recording controls on the bubble.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-22">
      <description>
        <p>Phase 3: overlay the webcam on the recording as a rectangle or a circle, in any corner, in three sizes.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-22">
      <description>
        <p>Phase 2: record the microphone and system audio (mixed, with a level meter and a limiter) into the MP4 as AAC.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-22">
      <description>
        <p>Phase 1 proof of concept: record a screen or window to MP4 through the ScreenCast portal.</p>
      </description>
    </release>
  </releases>
</component>
