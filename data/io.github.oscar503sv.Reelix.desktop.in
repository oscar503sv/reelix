[Desktop Entry]
Type=Application
# Translators: the app name; leave it untranslated (empty).
Name=Reelix
GenericName=Screen Recorder
Comment=Record your screen, a window, your microphone and webcam
Exec=reelix
Icon=io.github.oscar503sv.Reelix
Terminal=false
Categories=GTK;GNOME;AudioVideo;Video;Recorder;
# Translators: search terms, separated and ended by semicolons.
Keywords=screencast;screen;record;recorder;video;loom;
StartupNotify=true
DBusActivatable=false
Actions=record;

[Desktop Action record]
Name=Record Screen
Exec=reelix --record
